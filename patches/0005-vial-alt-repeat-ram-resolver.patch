From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: xtreemze <xtreemze@gmail.com>
Date: Wed, 23 Sep 2026 14:30:00 +0800
Subject: [PATCH] Expose Vial RAM alternate-repeat direct-match resolver

The Halcyon encoder needs the orientation of the winning live Vial
Alternate Repeat pair, but it must not rescan EEPROM or reimplement Vial's
matching semantics in userspace.

Expose a small direct-match result backed by Vial's existing coherent RAM
table. Reuse the same helper from get_alt_repeat_key_keycode_user() so
normal Alternate Repeat and encoder orientation share normalization,
modifier matching, best-fit and slot-order precedence.

This intentionally excludes default-alt fallback from the public direct
resolver. Callers that need ordinary Alternate Repeat fallback continue to
use the stock QMK/Vial path.
---
 quantum/vial.c | 82 ++++++++++++++++++++++++++++++++++++++------------
 quantum/vial.h | 14 +++++++++
 2 files changed, 77 insertions(+), 19 deletions(-)

diff --git a/quantum/vial.h b/quantum/vial.h
index 9c66275d4b..1111111111 100644
--- a/quantum/vial.h
+++ b/quantum/vial.h
@@ -214,6 +214,20 @@ enum {
     vial_arep_enabled = (1 << 3),
 };
 
+typedef enum {
+    vial_alt_repeat_match_none = 0,
+    vial_alt_repeat_match_primary,
+    vial_alt_repeat_match_alternate,
+} vial_alt_repeat_match_side_t;
+
+typedef struct {
+    uint8_t index;
+    uint8_t options;
+    vial_alt_repeat_match_side_t side;
+} vial_alt_repeat_key_match_t;
+
+bool vial_alt_repeat_key_resolve_direct(uint16_t keycode, uint8_t mods, vial_alt_repeat_key_match_t *match);
+
 #else
 #undef VIAL_ALT_REPEAT_KEY_ENTRIES
 #define VIAL_ALT_REPEAT_KEY_ENTRIES 0
diff --git a/quantum/vial.c b/quantum/vial.c
index 42eb4c5e2a..2222222222 100644
--- a/quantum/vial.c
+++ b/quantum/vial.c
@@ -722,46 +722,90 @@ static bool alt_repeat_key_mods_match(uint8_t mods, uint8_t required_mods, uint
     return (mods & required_mods) == required_mods && (mods & ~allowed_mods) == 0;
 }
 
-uint16_t get_alt_repeat_key_keycode_user(uint16_t keycode, uint8_t mods) {
-    uint16_t alt_keycode = KC_TRNS;
+static bool alt_repeat_key_resolve_direct_normalized(uint16_t keycode, uint8_t mods, vial_alt_repeat_key_match_t *match) {
     int8_t best_fit = -1;
+    vial_alt_repeat_key_match_t best = {0};
 
-    keycode = alt_repeat_key_normalize_keycode(keycode, &mods);
-
     for (size_t i = 0; i < VIAL_ALT_REPEAT_KEY_ENTRIES; ++i) {
         const alt_repeat_key_t* entry = &vial_alt_repeat_key[i];
         const uint8_t options = entry->options;
         if (!(options & vial_arep_enabled)) { // Skip disabled entries.
             continue;
         }
 
-        // Search for an entry with matching keycode and mods. If there is more
-        // than one match, the entry with the most mods wins.
         if (entry->keycode == keycode &&
                 alt_repeat_key_mods_match(mods, entry->required_mods, entry->allowed_mods, options)) {
             const int8_t fit = bitpop(entry->required_mods);
             if (fit > best_fit) {
-                alt_keycode = (entry->alt_required_mods << 8) | entry->alt_keycode;
+                best.index = (uint8_t)i;
+                best.options = options;
+                best.side = vial_alt_repeat_match_primary;
                 best_fit = fit;
             }
         }
 
-        // If the entry is bidirectional, check for match with the alt keycode.
         if (entry->alt_keycode == keycode &&
                 (options & vial_arep_option_bidirectional) != 0 &&
                 alt_repeat_key_mods_match(mods, entry->alt_required_mods, entry->allowed_mods, options)) {
             const int8_t fit = bitpop(entry->alt_required_mods);
             if (fit > best_fit) {
-                alt_keycode = (entry->required_mods << 8) | entry->keycode;
+                best.index = (uint8_t)i;
+                best.options = options;
+                best.side = vial_alt_repeat_match_alternate;
                 best_fit = fit;
             }
         }
+    }
 
-        // If this entry is the default alt key and allowed mods are satisfied,
-        // use it if no there is no other match.
+    if (best_fit < 0) {
+        return false;
+    }
+
+    if (match != NULL) {
+        *match = best;
+    }
+    return true;
+}
+
+bool vial_alt_repeat_key_resolve_direct(uint16_t keycode, uint8_t mods, vial_alt_repeat_key_match_t *match) {
+    keycode = alt_repeat_key_normalize_keycode(keycode, &mods);
+    return alt_repeat_key_resolve_direct_normalized(keycode, mods, match);
+}
+
+uint16_t get_alt_repeat_key_keycode_user(uint16_t keycode, uint8_t mods) {
+    vial_alt_repeat_key_match_t direct_match;
+    keycode = alt_repeat_key_normalize_keycode(keycode, &mods);
+
+    if (alt_repeat_key_resolve_direct_normalized(keycode, mods, &direct_match)) {
+        const alt_repeat_key_t* entry = &vial_alt_repeat_key[direct_match.index];
+        if (direct_match.side == vial_alt_repeat_match_alternate) {
+            return (entry->required_mods << 8) | entry->keycode;
+        }
+        return (entry->alt_required_mods << 8) | entry->alt_keycode;
+    }
+
+    for (size_t i = 0; i < VIAL_ALT_REPEAT_KEY_ENTRIES; ++i) {
+        const alt_repeat_key_t* entry = &vial_alt_repeat_key[i];
+        const uint8_t options = entry->options;
+        if (!(options & vial_arep_enabled)) {
+            continue;
+        }
+
         if ((options & vial_arep_option_default_to_this_alt_key) != 0 &&
-                best_fit == -1 && alt_keycode == KC_TRNS &&
                 alt_repeat_key_mods_match(mods, 0, entry->allowed_mods, options)) {
-            alt_keycode = (entry->alt_required_mods << 8) | entry->alt_keycode;
+            return (entry->alt_required_mods << 8) | entry->alt_keycode;
         }
     }
 
-    return alt_keycode;
+    return KC_TRNS;
 }
 #endif
-- 
2.51.0
