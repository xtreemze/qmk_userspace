From d7ad3bf8aa05ead807984845480542affb3a054e Mon Sep 17 00:00:00 2001
From: QMK upstream
Date: Wed, 12 Aug 2026 21:06:14 +0100
Subject: [PATCH] Backport Repeat Key weak mods for Key Overrides

Upstream QMK commit d7ad3bf8aa05ead807984845480542affb3a054e
fixes Repeat Key interaction with modifier-dependent Key Overrides by
including Repeat's restored weak modifiers while a repeat invocation is
active. Keep the conditional narrow rather than globally enabling weak
mods for ordinary Key Override matching.
---
 quantum/process_keycode/process_key_override.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/quantum/process_keycode/process_key_override.c b/quantum/process_keycode/process_key_override.c
--- a/quantum/process_keycode/process_key_override.c
+++ b/quantum/process_keycode/process_key_override.c
@@ -441,6 +441,10 @@ bool process_key_override(const uint16_t keycode, const keyrecord_t *const recor
 
 #ifdef KEY_OVERRIDE_INCLUDE_WEAK_MODS
     effective_mods |= get_weak_mods();
+#elif defined(REPEAT_KEY_ENABLE)
+    if (get_repeat_key_count()) {
+        effective_mods |= get_weak_mods();
+    }
 #endif
 
 #ifndef NO_ACTION_ONESHOT
